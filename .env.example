# 无真实密码的配置模板，可以提交到 Git。
# 复制为 .env 后在本机填写；不要将 .env 上传或分享。
# 数据库主机；默认 127.0.0.1；当前仅允许 127.0.0.1、localhost 或 ::1。
CAREERLENS_DB_HOST=127.0.0.1
# 本机发布端口；默认 5433，整数范围 1—65535，不是容器内部端口 5432。
CAREERLENS_DB_PORT=5433
# 数据库名；默认 careerlens_learning，必须为非空字符串，与实际库一致。
CAREERLENS_DB_NAME=careerlens_learning
# 连接用户名；默认 careerlens，必须为非空字符串，与授权用户一致。
CAREERLENS_DB_USER=careerlens

# 必须填写实际数据库密码；没有默认密码。
CAREERLENS_DB_PASSWORD=""

# 后续新增配置时只添加变量名与安全默认值，不能将真实秘密复制回模板。
